---
import { profile, navigation } from '../../data/profile';

interface Props {
  canonicalPath: string;
}

const { canonicalPath } = Astro.props;
const isModels = canonicalPath.startsWith('/models');
---
<header class="site-header-bar">
  <div class="site-header wrap">
    <a class="wordmark" href="/" aria-label={`${profile.name} home`}>
      <span class="google-dots" aria-hidden="true">
        <span class="g-dot g-blue"></span>
        <span class="g-dot g-red"></span>
        <span class="g-dot g-yellow"></span>
        <span class="g-dot g-green"></span>
      </span>
      <span class="wordmark-text">{profile.name}</span>
    </a>
    <nav aria-label="Main navigation">
      {navigation.map(item => {
        const isExternal = item.href.startsWith('https:');
        const isButton = item.label === 'Email';
        const isSecondary = item.label === 'About' || item.label === 'Skills';
        const isActive =
          (item.href === '/models' && isModels) ||
          (item.href === '/#work' && !isModels);
        return (
          <a
            class:list={{
              'nav-pill': !isButton,
              'nav-pill-active': isActive && item.href === '/models',
              'secondary-nav': isSecondary,
              'external-nav': isExternal,
              'nav-button': isButton,
            }}
            href={item.href}
            aria-current={item.href === '/models' && isModels ? 'page' : undefined}
            target={isExternal ? '_blank' : undefined}
            rel={isExternal ? 'noopener noreferrer' : undefined}
          >
            {item.label}
            {isExternal && <span class="link-arrow" aria-hidden="true">↗</span>}
          </a>
        );
      })}
      <button
        type="button"
        id="theme-toggle"
        class="theme-toggle"
        aria-label="Switch color theme"
        title="Switch light / dark theme"
      >
        <svg
          class="theme-icon icon-sun"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
        <svg
          class="theme-icon icon-moon"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>
<script>
  import '../../scripts/theme';
</script>
